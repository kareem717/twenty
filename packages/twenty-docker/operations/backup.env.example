DEPLOYMENT_DIRECTORY=/srv/twenty
DATABASE_DIRECTORY=/srv/twenty/database
STAGING_DIRECTORY=/var/backups/twenty/staging
PROXY_CONFIGURATION_FILE=/etc/caddy/twenty.caddy
BACKUP_HOST=crm-server
POSTGRES_USER=postgres
POSTGRES_DATABASE=default
RESTIC_REPOSITORY=s3:https://s3.REGION.backblazeb2.com/BUCKET/restic
AWS_ACCESS_KEY_ID=REPLACE_WITH_BUCKET_SCOPED_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_BUCKET_SCOPED_KEY
RESTIC_PASSWORD_FILE=/etc/twenty-crm-backup/repository-password
RESTIC_CACHE_DIR=/var/cache/restic/twenty
