{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "src/*": ["./src/*"]
    },
    "types": ["node", "vite/client"]
  },
  "include": ["src", "vitest.config.ts"]
}
